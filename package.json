{
  "name": "library-cli",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "description": "Sistema de Gerenciamento de Biblioteca via Terminal (CLI) - Node.js + TypeScript + PostgreSQL",
  "main": "dist/main.js",
  "scripts": {
    "setup": "ts-node src/scripts/setup-db.ts",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "jest --config jest.config.cjs",
    "test:coverage": "jest --config jest.config.cjs --coverage"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "date-fns": "^4.1.0",
    "dotenv": "^16.6.1",
    "inquirer": "^8.2.7",
    "pg": "^8.16.3",
    "uuid": "^9.0.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/uuid": "^10.0.0",
    "jest": "^30.0.5",
    "ts-jest": "^29.4.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.2"
  }
}
