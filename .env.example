# Configuração do Banco de Dados PostgreSQL
# Este arquivo é um template. Copie para .env e ajuste os valores

# Host do PostgreSQL (geralmente localhost em desenvolvimento)
DB_HOST=localhost

# Porta do PostgreSQL (padrão: 5432)
DB_PORT=5432

# Usuário do PostgreSQL (padrão: postgres)
DB_USER=postgres

# Senha do usuário postgres
# ⚠️ IMPORTANTE: Não commitar este arquivo com dados reais no Git!
DB_PASSWORD=postgres

# Nome do banco de dados
# Será criado automaticamente pelo script de setup
DB_NAME=biblioteca